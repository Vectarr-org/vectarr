<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    IIS rejects request bodies over ~28.6 MB by default, before ASP.NET Core sees them.
    Instant quote CAD uploads (POST api/QuoteRequest/Create) allow up to 150 MB, which the
    controller enforces with [RequestSizeLimit]. Keep this value in sync with
    QuoteRequestController.MaxUploadBytes. The SDK adds the aspNetCore handler on publish.
  -->
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="157286400" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
